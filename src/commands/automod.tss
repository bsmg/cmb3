                        )
                )
                .addSubcommand(subcommand =>
                    subcommand
                        .setName("remove")
                        .setDescription("Removes a list of strings")
                        .addStringOption(option =>
                            option
                                .setName("content")
                                .setDescription("Content to be removed, separated by \"|\"")
                                .setRequired(true)
                        )
                )
        )

    public async execute(interaction: CommandInteraction<CacheType>) {

        if (!interaction.guild) {
            await interaction.reply({  content: "Guild is null!", ephemeral: true });
            return;
        }

        const options = interaction.options as CommandInteractionOptionResolver;

        const automod = interaction.guild.autoModerationRules;
        
        const rules = await automod.fetch();

        switch (options.getSubcommandGroup()) {
            case "spam-filter":
                await this.handleSpamFilter(interaction, rules);
        }

        const rule = rules.find(x => x.name === "ChannelMonitorBot Message Filter");

        if (rule) {
            await rule.setKeywordFilter(rule.triggerMetadata.keywordFilter.);
        }
        

        await interaction.guild?.autoModerationRules.create({
            name: "Testing",
            enabled: true,
            eventType: AutoModerationRuleEventType.MessageSend,
            triggerType: AutoModerationRuleTriggerType.Keyword,
            triggerMetadata: {
                keywordFilter: filter
             },
            actions: [
                {
                    type: AutoModerationActionType.BlockMessage,
                    metadata: {
                        channel: ClientManager.instance.client.channels.cache.get(Configuration.instance.automodChannel) as TextChannel,
                        durationSeconds: 10,
                        customMessage: "This message was automatically deleted"
                    }
                }
            ]
        }).catch(error => console.log(error));
    }

    private async handleSpamFilter(interaction: CommandInteraction<CacheType>, rules: Collection<string, AutoModerationRule>) {

    }
}